{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Monthly cost savings estimate by tenant (USD)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "finops_cost_savings_usd_monthly",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "drawStyle": "line", "fillOpacity": 15 }
        }
      }
    },
    {
      "title": "Resources shut down / downsized (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tenant, action, dry_run) (rate(finops_resources_shutdown_total[5m]))",
          "legendFormat": "{{tenant}} {{action}} dry_run={{dry_run}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Cumulative live savings by tenant (USD)",
      "description": "Increases only when remediate runs with dry_run=false (--apply).",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tenant) (finops_cost_savings_usd_total)",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "title": "Actionable findings by tenant",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tenant) (finops_findings_actionable)",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Shutdowns by kind (top)",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (kind) (finops_resources_shutdown_total)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Service up / last scan age",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "finops_service_up", "legendFormat": "up", "refId": "A" },
        { "expr": "time() - finops_last_scan_timestamp_seconds", "legendFormat": "seconds since scan", "refId": "B" }
      ]
    },
    {
      "title": "Scan duration",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 16, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(finops_scan_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["finops", "cost", "prometheus"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Net FinOps Agent — Tenant Savings & Shutdowns",
  "uid": "net-finops-agent",
  "version": 1
}
